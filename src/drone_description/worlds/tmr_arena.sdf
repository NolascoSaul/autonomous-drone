<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="arena_drone_tmr">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <!-- Escena Indoor -->
    <scene>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="indoor_light">
      <cast_shadows>false</cast_shadows>
      <pose>5 5 4 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.1 0.1 -0.9</direction>
    </light>

    <!-- Suelo -->
    <model name="ground_plane">
      <static>true</static>
      <pose>5 5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- LÍMITES DE LA ARENA (10x10x4 m) -->
    <model name="arena_boundary">
      <static>true</static>
      <!-- Pared Inferior (Y=0, detrás del despegue) -->
      <link name="wall_y0">
        <pose>5 0 2 0 0 0</pose>
        <collision name="col"><geometry><box><size>10 0.1 4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10 0.05 4</size></box></geometry><material><ambient>0.2 0.4 0.8 0.2</ambient><diffuse>0.2 0.4 0.8 0.2</diffuse></material></visual>
      </link>
      <!-- Pared Superior (Y=10, frente, zona del pizarrón) -->
      <link name="wall_y10">
        <pose>5 10 2 0 0 0</pose>
        <collision name="col"><geometry><box><size>10 0.1 4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10 0.05 4</size></box></geometry><material><ambient>0.2 0.4 0.8 0.2</ambient><diffuse>0.2 0.4 0.8 0.2</diffuse></material></visual>
      </link>
      <!-- Pared Izquierda (X=0, al lado del Free Path) -->
      <link name="wall_x0">
        <pose>0 5 2 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.1 10 4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.05 10 4</size></box></geometry><material><ambient>0.2 0.4 0.8 0.2</ambient><diffuse>0.2 0.4 0.8 0.2</diffuse></material></visual>
      </link>
      <!-- Pared Derecha (X=10) -->
      <link name="wall_x10">
        <pose>10 5 2 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.1 10 4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.05 10 4</size></box></geometry><material><ambient>0.2 0.4 0.8 0.2</ambient><diffuse>0.2 0.4 0.8 0.2</diffuse></material></visual>
      </link>
      <link name="ceiling_z4">
        <pose>5 5 4 0 0 0</pose>
        <collision name="col"><geometry><box><size>10 10 0.1</size></box></geometry></collision>
      </link>
    </model>

    <!-- MISIÓN 1: TÚNELES -->
    <!-- CARRIL ANCHO (Azul) -->
    <model name="m1_tunel_ancho_1"><static>true</static><pose>1.5 2.0 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_ancha.stl</uri></mesh></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_ancho_2"><static>true</static><pose>1.5 2.5 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_ancha.stl</uri></mesh></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_ancho_3"><static>true</static><pose>1.5 3.0 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_ancha.stl</uri></mesh></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_ancho_4"><static>true</static><pose>1.5 3.5 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_ancha.stl</uri></mesh></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_ancho_5"><static>true</static><pose>1.5 4.0 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_ancha.stl</uri></mesh></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material></visual></link></model>

    <!-- CARRIL MEDIO (Verde) -->
    <model name="m1_tunel_medio_1"><static>true</static><pose>3.5 2.0 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_media.stl</uri></mesh></geometry><material><ambient>0.5 0.8 0.1 1</ambient><diffuse>0.5 0.8 0.1 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_medio_2"><static>true</static><pose>3.5 2.5 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_media.stl</uri></mesh></geometry><material><ambient>0.5 0.8 0.1 1</ambient><diffuse>0.5 0.8 0.1 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_medio_3"><static>true</static><pose>3.5 3.0 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_media.stl</uri></mesh></geometry><material><ambient>0.5 0.8 0.1 1</ambient><diffuse>0.5 0.8 0.1 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_medio_4"><static>true</static><pose>3.5 3.5 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_media.stl</uri></mesh></geometry><material><ambient>0.5 0.8 0.1 1</ambient><diffuse>0.5 0.8 0.1 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_medio_5"><static>true</static><pose>3.5 4.0 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_media.stl</uri></mesh></geometry><material><ambient>0.5 0.8 0.1 1</ambient><diffuse>0.5 0.8 0.1 1</diffuse></material></visual></link></model>

    <!-- CARRIL ESTRECHO (Rojo) -->
    <model name="m1_tunel_estrecho_1"><static>true</static><pose>5.0 2.0 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_chica.stl</uri></mesh></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_estrecho_2"><static>true</static><pose>5.0 2.5 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_chica.stl</uri></mesh></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_estrecho_3"><static>true</static><pose>5.0 3.0 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_chica.stl</uri></mesh></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_estrecho_4"><static>true</static><pose>5.0 3.5 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_chica.stl</uri></mesh></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="m1_tunel_estrecho_5"><static>true</static><pose>5.0 4.0 0 1.5708 0 0</pose><link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m1_compuerta_chica.stl</uri></mesh></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link></model>

    <!-- MISIÓN 2: PIZARRÓN Y ARUCO ID 100 -->
    <model name="mision2_pizarron">
      <static>true</static>
      <pose>9.8 7.5 1.0 0 0 1.5708</pose>
      <link name="link">
        <visual name="vis_pizarron">
          <geometry><mesh><uri>model://drone_description/meshes/m2_pizarron.stl</uri></mesh></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="vis_aruco">
          <pose>0.90 -0.026 0.60 0 0 0</pose>
          <geometry><box><size>0.20 0.001 0.20</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>model://drone_description/materials/textures/m2_aruco.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- MISIÓN 3: CAJAS DE AUXILIO -->
    <model name="m3_caja_1">
      <static>true</static><pose>8.5 4.5 0.18 0 0 0.4</pose> 
      <link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m3_caja_busqueda.stl</uri></mesh></geometry></visual></link>
    </model>
    <model name="m3_caja_2">
      <static>true</static><pose>7.0 8.5 0.18 0 0 -0.5</pose> 
      <link name="link"><visual name="vis"><geometry><mesh><uri>model://drone_description/meshes/m3_caja_busqueda.stl</uri></mesh></geometry></visual></link>
    </model>

    <!-- MISIÓN 4: PLATAFORMA DE ATERRIZAJE -->
    <model name="mision4_plataforma">
      <static>true</static>
      <pose>8 1 0.15 0 0 1.5708</pose>
      <link name="link">
        <visual name="vis_plataforma_base">
          <geometry><mesh><uri>model://drone_description/meshes/m4_plataforma_base.stl</uri></mesh></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
        <visual name="vis_plataforma_textura">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><box><size>1.0 1.0 0.001</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>model://drone_description/materials/textures/m4_plataforma.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- DRON X3 UAV -->
    <include>
      <pose>1 0.5 0 0 0 1.5708</pose>
      <uri>model://drone_description/models/x3_uav</uri>
    </include>
  </world>
</sdf>